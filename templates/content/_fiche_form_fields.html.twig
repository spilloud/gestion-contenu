{# Champs communs fiche contenu (hors vidéo) : équipe, liens KDrive, texte #}
<section id="bloc-equipe" class="content-fiche__section">
    <div class="content-fiche__section-head">
        <h2>Équipe</h2>
        <span class="content-fiche__section-kicker">Délégation</span>
    </div>
    <p class="vf-team-hint">Assignez le médiamaticien et la CM pour ce contenu. Par défaut, les valeurs du client sont proposées.</p>
    <div class="vf-team-grid">
        {% if form.videoEditor is defined %}
            {{ form_row(form.videoEditor) }}
        {% endif %}
        {% if form.videoCommunityManager is defined %}
            {{ form_row(form.videoCommunityManager) }}
        {% endif %}
    </div>
    {# Sur la création, l'échéance est déjà affichée plus haut (wrap vidéo) — éviter le double render Symfony. #}
    {% if content.id and form.asanaMontageDueOn is defined %}
        <div style="margin-top: 0.75rem;">
            {{ form_row(form.asanaMontageDueOn) }}
        </div>
    {% endif %}
</section>

{% if content.id %}
<section id="bloc-asana" class="content-fiche__section">
    <div class="content-fiche__section-head">
        <h2>Asana monteur</h2>
        <span class="content-fiche__section-kicker">Création post</span>
    </div>
    {% if content.asanaTaskGid %}
        <p style="margin: 0 0 0.75rem;">
            Tâche liée :
            <a href="https://app.asana.com/0/0/{{ content.asanaTaskGid }}" target="_blank" rel="noopener">
                ouvrir dans Asana
            </a>
        </p>
        <div style="display:flex; gap: 0.6rem; flex-wrap: wrap;">
            <button type="submit" form="content-asana-sync-form-{{ content.id }}" class="btn" style="background:#0369a1;">↻ Rafraîchir depuis Asana</button>
        </div>
    {% else %}
        <p style="color: var(--muted); margin: 0 0 0.75rem;">
            Crée une tâche Asana <strong>Création post - {{ content.title }}</strong> pour le médiamaticien assigné.
        </p>
        <button type="submit" form="content-asana-create-form-{{ content.id }}" class="btn">Créer la tâche Asana monteur</button>
    {% endif %}
</section>
{% endif %}

<section id="bloc-fichiers" class="content-fiche__section">
    <div class="content-fiche__section-head">
        <h2>Fichiers & liens</h2>
        <span class="content-fiche__section-kicker">KDrive</span>
    </div>
    {% if form.videoRushesUrl is defined %}
        {% include 'videos/_link_field.html.twig' with {
            label: 'Source',
            form_field: form.videoRushesUrl,
            initial_url: content.videoRushesUrl|default(null),
        } %}
    {% endif %}
    {% if form.videoFinalUrl is defined %}
        {% include 'videos/_link_field.html.twig' with {
            label: 'Final',
            form_field: form.videoFinalUrl,
            initial_url: content.videoFinalUrl|default(null),
        } %}
    {% endif %}
</section>

<section id="bloc-texte" class="content-fiche__section">
    <div class="content-fiche__section-head">
        <h2>Texte & notes</h2>
    </div>
    {% if form.videoCaption is defined %}
        {{ form_row(form.videoCaption) }}
    {% endif %}
    {% if form.notes is defined %}
        {{ form_row(form.notes) }}
    {% endif %}
</section>
